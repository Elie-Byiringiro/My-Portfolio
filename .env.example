# Copy this file to .env and fill in your keys
# Supabase: create a free project at https://supabase.com, then grab these from
# Project Settings > API. Run supabase/schema.sql once from the SQL editor.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Optional: Live AI assistant chat (from https://openrouter.ai/settings/keys)
# Note: VITE_ vars are bundled into the public JS, so anyone can read this key.
# For a production site, proxy OpenRouter through your own backend or a serverless
# function and keep the key there instead.
VITE_OPENROUTER_API_KEY=sk-or-v1-xxxxxxxx
VITE_OPENROUTER_MODEL=openai/gpt-4o