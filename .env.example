# Copy this file to .env and fill in your keys
# Supabase: create a free project at https://supabase.com, then grab these from
# Project Settings > API. Run supabase/schema.sql once from the SQL editor.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# AI assistant (https://openrouter.ai/settings/keys)
# Preferred: the serverless function in api/chat.js reads these. They stay on the
# server, so the key is never exposed in the browser bundle.
OPENROUTER_API_KEY=sk-or-v1-your-key-here
OPENROUTER_MODEL=openai/gpt-4o-mini

# The server also reads Supabase to ground answers in your live portfolio data.
# Falls back to src/lib/fallbackData.js when these are blank.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# Only used if the /api/chat function is unavailable (e.g. plain static hosting).
# VITE_ vars are bundled into public JS, so this key is readable by visitors.
# Leave blank on real deployments.
VITE_OPENROUTER_API_KEY=
VITE_OPENROUTER_MODEL=openai/gpt-4o-mini